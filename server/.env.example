# Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# Server port
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/shipyard

# Allowed frontend client URL for CORS
CLIENT_URL=http://localhost:5173

# Secret key for signing access tokens (15m expiry)
JWT_ACCESS_SECRET=development_jwt_access_secret_key_change_in_production_min32chars

# Secret key for signing refresh tokens (7d expiry)
JWT_REFRESH_SECRET=development_jwt_refresh_secret_key_change_in_production_min32chars

# Access token time-to-live string (e.g. 15m)
ACCESS_TOKEN_TTL=15m

# Refresh token time-to-live in days
REFRESH_TOKEN_TTL_DAYS=7

# Cookie domain (optional, leave empty for localhost / same-domain)
COOKIE_DOMAIN=

# Initial default admin credentials for seeding / admin access
ADMIN_EMAIL=admin@shipyard.dev
ADMIN_PASSWORD=AdminSecurePassword123!
